# Cloudinary — optional. Unset simply serves image srcs as authored.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Search-engine ownership verification. Both are optional: when a value is
# empty the corresponding <meta> tag is omitted entirely rather than rendered
# blank (a blank token reads as a failed verification, not an absent one).
#
# Google  — Search Console › Settings › Ownership verification › HTML tag.
#           Copy only the token, not the whole <meta> element.
# Bing    — Bing Webmaster Tools › Site verification › Meta tag (msvalidate.01).
#
# For production these are set as GitHub repository *variables* and passed
# through in .github/workflows/nextjs.yml, so the tokens never enter git.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
